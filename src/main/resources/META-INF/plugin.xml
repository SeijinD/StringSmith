<idea-plugin>
    <id>com.seijind.stringsmith</id>
    <name>StringSmith – Android String Extractor</name>
    <vendor email="seijindemon@protonmail.com" url="https://github.com/SeijinD">SeijinD</vendor>
    <description><![CDATA[
        <p><b>StringSmith</b> extracts hardcoded strings into Android <code>strings.xml</code> resources.</p>
        <ul>
            <li>Context-aware replacement (<code>stringResource</code>, <code>getString</code>, <code>@string/</code>)</li>
            <li>Auto-import for Compose <code>stringResource</code></li>
            <li>Duplicate key detection &amp; value reuse</li>
            <li>Multi-locale placeholder generation (<code>values-*</code>)</li>
            <li>Quick-fix intention on hardcoded literals</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    <depends>org.jetbrains.kotlin</depends>
    <depends optional="true" config-file="stringsmith-android.xml">org.jetbrains.android</depends>

    <resource-bundle>messages.StringSmithBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection
            language=""
            shortName="StringSmithHardcodedString"
            displayName="Hardcoded string can be extracted to strings.xml"
            groupName="StringSmith"
            enabledByDefault="true"
            level="WARNING"
            implementationClass="com.seijind.stringsmith.inspections.HardcodedStringInspection"/>
        <intentionAction>
            <className>com.seijind.stringsmith.intentions.ExtractStringResourceIntention</className>
            <category>StringSmith</category>
        </intentionAction>
        <applicationConfigurable
            parentId="tools"
            id="com.seijind.stringsmith.settings"
            displayName="StringSmith – Android String Extractor"
            instance="com.seijind.stringsmith.settings.StringSmithConfigurable"/>
        <applicationService
            serviceImplementation="com.seijind.stringsmith.settings.StringSmithSettings"/>
    </extensions>

    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <actions>
        <action id="com.seijind.stringsmith.ExtractStringResourceAction"
                class="com.seijind.stringsmith.actions.ExtractStringResourceAction"
                text="Extract to strings.xml"
                description="Extract hardcoded string to Android strings.xml">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt X"/>
        </action>
        <action id="com.seijind.stringsmith.QuickExtractStringResourceAction"
                class="com.seijind.stringsmith.actions.QuickExtractStringResourceAction"
                text="Quick Extract to strings.xml"
                description="Extract hardcoded string without dialog when unambiguous">
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift X"/>
        </action>
        <action id="com.seijind.stringsmith.BatchExtractStringResourceAction"
                class="com.seijind.stringsmith.actions.BatchExtractStringResourceAction"
                text="Batch Extract Strings in File"
                description="Extract all hardcoded strings in current file in one pass">
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift B"/>
        </action>
    </actions>
</idea-plugin>
